# Copy this file to .env (in this backend folder) and fill in your key.
# Model names change often: check your provider's current model list.

# Option A: OpenRouter (any model at openrouter.ai/models, copy its ID)
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-4o-mini
OPENAI_API_KEY=sk-or-v1-your_openrouter_key
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Option B: Groq (also: pip install langchain-groq)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=your_key_here

# Option C: OpenAI directly (remove the two BASE lines above)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your_key_here

FRONTEND_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20
