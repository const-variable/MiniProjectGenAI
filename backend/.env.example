# Groq-hosted open-weight chat model (list available ones at https://console.groq.com/docs/models).
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=your_groq_key_here

FRONTEND_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20
MAX_TABLES_PER_UPLOAD=20
MAX_ROWS_PER_TABLE=1000000
MAX_RESULT_ROWS=1000
SQLITE_QUERY_TIMEOUT_SECONDS=15
MAX_DB_TABLES=50
PROFILE_SAMPLE_ROWS=5000

# Optional local response cache: sqlite
# LLM_CACHE=sqlite
